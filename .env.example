# Copie para `.env` e preencha. O `.env` real nunca vai para o repositório.
# Este repositório é público: não coloque valor nenhum neste arquivo de exemplo.

# --- Supabase ---
# Senha do banco do projeto de staging (base-crm-staging, sa-east-1).
SUPABASE_DB_PASSWORD=
# Projeto remoto de staging. Ref: ehchyqetsswpbienhlni
SUPABASE_PROJECT_REF=
# URL e chaves do projeto: Dashboard > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare ---
# Conta usada pelo Wrangler. `wrangler whoami` mostra o ID.
CLOUDFLARE_ACCOUNT_ID=
# Token de API apenas para CI; no ambiente local o Wrangler usa OAuth (`wrangler login`).
CLOUDFLARE_API_TOKEN=
